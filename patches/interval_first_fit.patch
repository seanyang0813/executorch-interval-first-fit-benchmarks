+        graph_module = self._graph_module(specs)
+
+        greedy_result = greedy(
+            1,
+            set(specs),
+            graph_module,
+            cast(ExportGraphSignature, None),
+        )
+        first_fit_result = interval_first_fit(
+            1,
+            set(specs),
+            graph_module,
+            cast(ExportGraphSignature, None),
